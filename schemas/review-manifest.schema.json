{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheSpyglassofOdysseus/asset-viewer/schemas/review-manifest.schema.json",
  "title": "Asset Viewer review manifest",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "counts",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "counts": {
      "type": "object",
      "required": [
        "total",
        "present",
        "missing",
        "approved",
        "maybe",
        "rejected",
        "unreviewed",
        "new"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "present": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "approved": {
          "type": "integer",
          "minimum": 0
        },
        "maybe": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "unreviewed": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewItem"
      }
    }
  },
  "$defs": {
    "reviewItem": {
      "type": "object",
      "required": [
        "asset_id",
        "collection",
        "collection_label",
        "rel",
        "status",
        "comment",
        "present",
        "annotations"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "collection": {
          "type": "string"
        },
        "collection_label": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "status": {
          "enum": [
            "",
            "approved",
            "maybe",
            "rejected"
          ]
        },
        "comment": {
          "type": "string"
        },
        "first_seen_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "seen_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "present": {
          "type": "boolean"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mtime_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "review_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        }
      },
      "additionalProperties": true
    },
    "annotation": {
      "type": "object",
      "required": [
        "annotation_id",
        "asset_id",
        "collection",
        "kind",
        "x",
        "y",
        "w",
        "h",
        "text",
        "resolved",
        "stale",
        "created_at",
        "updated_at",
        "content_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "collection": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "point",
            "region"
          ]
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "resolved": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "additionalProperties": true
}
